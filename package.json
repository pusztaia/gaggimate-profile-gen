{
  "name": "gaggimate-profile-gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GaggiMate flavour profile generator: shared extraction-profile engine plus a standalone browser tool and Preact components for the GaggiMate device UI.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write tests eslint.config.js package.json",
    "format:check": "prettier --check tests eslint.config.js package.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^3.0.4"
  }
}
